{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "global.d.ts",
    "index.ts",
    "bin/*.js",
    "lib/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
